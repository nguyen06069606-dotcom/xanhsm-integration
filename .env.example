# ===== Chung =====
# fake  = chạy Fake API để test (BỎ "fake" khi dùng API thật)
# proxy = chạy Caddy (HTTPS + tên miền cho dashboard)
COMPOSE_PROFILES=fake,proxy
TZ=Asia/Ho_Chi_Minh

# ===== PostgreSQL (chỉ dùng chữ và số cho mật khẩu) =====
POSTGRES_DB=xanhsm
POSTGRES_USER=xanhsm
POSTGRES_PASSWORD=ChangeMe123456

# ===== Xanh SM API: KHI CÓ API THẬT CHỈ SỬA PHẦN NÀY =====
API_BASE_URL=http://fake-api:8000
# Kiểu xác thực: none | bearer | header | oauth2
API_AUTH_MODE=oauth2
# bearer / header
API_KEY=
API_KEY_HEADER=X-API-Key
# oauth2 (client credentials)
API_TOKEN_URL=/oauth/token
API_CLIENT_ID=demo-client
API_CLIENT_SECRET=demo-secret
# Đường dẫn lấy danh sách chuyến + tên field phân trang trong JSON
API_TRIPS_PATH=/v1/trips
API_DATA_KEY=data
API_TOTAL_PAGES_KEY=total_pages
API_PAGE_SIZE=100
API_TIMEOUT=20
API_MAX_RETRIES=5

# ===== Worker đồng bộ =====
SYNC_INTERVAL_SECONDS=60
# Lùi cursor lại một đoạn để không sót dữ liệu (trùng đã được DB chặn)
SYNC_OVERLAP_MINUTES=5
INITIAL_SYNC_FROM=2024-01-01T00:00:00+00:00

# ===== API Monitor =====
# Với API thật, đổi sang endpoint nhẹ mà bên Xanh SM cho phép gọi
MONITOR_PATH=/health
MONITOR_INTERVAL_SECONDS=30
MONITOR_FAIL_THRESHOLD=3
# Cảnh báo Telegram (để trống nếu không dùng)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Dashboard =====
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=DoiMatKhauNay2026
# Tên miền cho Caddy (cần bản ghi A trỏ về IP server)
DASHBOARD_DOMAIN=dashboard.sacogroup.vn
# 127.0.0.1 = chỉ qua Caddy. Đặt 0.0.0.0 nếu muốn vào thẳng IP:8000
DASHBOARD_BIND=127.0.0.1

# ===== Fake API (chỉ khi profile fake) =====
FAKE_TICK_SECONDS=3
# Tỉ lệ lỗi 503 ngẫu nhiên để test retry, ví dụ 0.05
FAKE_ERROR_RATE=0
